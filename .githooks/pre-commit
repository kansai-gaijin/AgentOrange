#!/bin/sh
# This repo is public, so this stops local databases and keys from being committed.
# Turn it on after cloning with: git config core.hooksPath .githooks

status=0

. "$(dirname "$0")/private-text"

# Who's committing goes public with the commit.
for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    if ! git var "$ident" | is_public_safe; then
        echo "Blocked: that's about who's committing. Use GitHub's no-reply address." >&2
        status=1
    fi
done

while IFS= read -r file; do
    # A commit that only deletes or rewords has no files to check.
    [ -n "$file" ] || continue

    # A file's name is as public as what's in it.
    check_file "$file" ":$file" || status=1
done <<EOF
$(git -c core.quotePath=off diff --cached --name-only --diff-filter=ACMRT)
EOF

exit $status
