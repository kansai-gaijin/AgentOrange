# Shared by this folder's hooks. This repo is public, and that includes file names and commit messages.

# Names that can't be told apart by a pattern, such as a server's public address. One per line, in a
# file that lives inside .git, so the list itself can't be committed.
private_words="$(git rev-parse --git-dir)/private-words"
private_list=""
if [ -f "$private_words" ]; then
    private_list="$(tr -d '\r' < "$private_words" | tr '[:upper:]' '[:lower:]' | grep -v '^[[:space:]]*$')"
fi

# Reads text, and says why if it shouldn't go public.
is_public_safe() {
    # Kept as a file, because a shell variable would mangle a binary one, and hold all of a big one.
    text="$(mktemp)"
    cat > "$text"
    checks_out "$text"
    answer=$?
    rm -f "$text"
    return $answer
}

checks_out() {
    # Images and documents carry text too, such as paths and names in their metadata. Their
    # readable runs are checked, plain and with UTF-16's zero bytes taken out.
    if [ -s "$1" ] && ! grep -Iq . "$1"; then
        readable="$(mktemp)"
        { LC_ALL=C tr -c '[:print:]' '\n' < "$1"; LC_ALL=C tr -d '\000' < "$1" | LC_ALL=C tr -c '[:print:]' '\n'; } | grep -aE '.{4,}' > "$readable"
        checks_text "$readable"
        answer=$?
        rm -f "$readable"
        return $answer
    fi
    checks_text "$1"
}

checks_text() {
    if grep -IqE '[A-Za-z]:[\\/]+Users[\\/]+[A-Za-z0-9]|/(Users|home)/[A-Za-z0-9]|[[:alnum:]-]+\.ts\.net|\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+\b|\b192\.168\.[0-9]+\.[0-9]+\b|\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+\b|\b10\.[0-9]+\.[0-9]+\.[0-9]+\b' "$1"; then
        echo "Blocked: this seems to hold a personal path or a private address." >&2
        return 1
    fi
    if grep -IoE '[[:alnum:]._%+-]+@([[:alnum:]-]+\.)+[[:alpha:]]{2,}' "$1" | grep -vqE '^git@github\.com$|@example\.(com|org)$|@users\.noreply\.github\.com$|^noreply@anthropic\.com$'; then
        echo "Blocked: this seems to hold an email address." >&2
        return 1
    fi
    if [ -n "$private_list" ] && ! grep -Iq . "$1"; then
        : # Empty or binary, with nothing to read.
    elif [ -n "$private_list" ] && tr '[:upper:]' '[:lower:]' < "$1" | grep -qF -e "$private_list"; then
        echo "Blocked: this holds something on this PC's private list." >&2
        return 1
    fi
    return 0
}

# Checks one file's name and what's in it. The second argument is where Git has its content, such
# as :path for what's staged, or commit:path. Says why, and fails, if it shouldn't go public.
check_file() {
    if ! printf '%s
' "$1" | is_public_safe; then
        echo "Blocked: that's about the name of $1." >&2
        return 1
    fi

    hook=no
    case "$1" in
        .githooks/private-text) hook=yes ;; # It names the very patterns it looks for, so only that check is skipped.
        *.db | *.db-* | *.sqlite | *.sqlite-* | *.sqlite3 | *.sqlite3-*)
            echo "Blocked: $1 looks like a database." >&2
            return 1
            ;;
    esac

    # What can't be read can't be checked, so it doesn't get through.
    if ! git cat-file -e "$2" 2>/dev/null; then
        echo "Blocked: couldn't read $1 to check it." >&2
        return 1
    elif [ "$(git show "$2" | head -c 15)" = "SQLite format 3" ]; then
        echo "Blocked: $1 is a database, whatever its name says." >&2
        return 1
    elif [ "$hook" = no ] && git show "$2" | grep -aqE 'BEGIN [A-Z ]*PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|TunnelSecret|postgres(ql)?://[^:$[:space:]]+:[^@$[:space:]]+@|AGENT_ORANGE_PAIRING_KEY=[^$[:space:]]'; then
        echo "Blocked: $1 seems to hold a private key or token." >&2
        return 1
    elif ! git show "$2" | is_public_safe; then
        echo "Blocked: that's about $1." >&2
        return 1
    fi
    return 0
}
