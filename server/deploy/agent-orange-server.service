[Unit]
Description=Agent Orange server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=agentorange
Group=agentorange
EnvironmentFile=/etc/agent-orange/server.env
ExecStart=/opt/agent-orange/current/agent-orange-server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Where it notes how far its data has got, to spot a backup restored over it.
StateDirectory=agent-orange

[Install]
WantedBy=multi-user.target
