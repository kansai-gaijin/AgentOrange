[Unit]
Description=Agent Orange server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=agentorange
Group=agentorange
EnvironmentFile=/etc/agent-orange/server.env
ExecStart=/opt/agent-orange/current/agent-orange-server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
