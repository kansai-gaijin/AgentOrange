<UserControl x:Class="AgentOrange.SettingsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             KeyDown="Modal_KeyDown"
             PreviewKeyDown="Modal_PreviewKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ContentBackground" Color="#17212B" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#1E2D3B" />
        <SolidColorBrush x:Key="SelectedBackground" Color="#324F66" />
        <SolidColorBrush x:Key="HoverBackground" Color="#27394A" />
        <SolidColorBrush x:Key="ControlBackground" Color="#364350" />
        <SolidColorBrush x:Key="Line" Color="#3D4854" />
        <SolidColorBrush x:Key="ModalBorder" Color="#2F3E4C" />
        <SolidColorBrush x:Key="Accent" Color="#5BD0D6" />
        <SolidColorBrush x:Key="TextStrong" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextNormal" Color="#E4E8EC" />
        <SolidColorBrush x:Key="TextMuted" Color="#A9B4BF" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Sidebar item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource SelectedBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill toggle -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="30" Height="17" CornerRadius="8.5" Background="#5A6877">
                            <Ellipse x:Name="Knob" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#17212B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled control, used for dropdowns and buttons in rows -->
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="#4C5A68" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#425160" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain text button in the header -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="5" Padding="7,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selectable row in a list beside a detail panel -->
        <Style x:Key="ListItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1B2834" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource SidebarBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextStrong}" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="#4C5A68" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="210" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field for a secret -->
        <Style x:Key="SecretField" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextStrong}" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="#4C5A68" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main action in a dialog -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#10202A" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#7ADDE2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The "Add provider" row at the end of the list -->
        <Style x:Key="AddRow" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1B2834" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A provider to pick in the wizard -->
        <Style x:Key="ProviderTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="#27333F" BorderBrush="#27333F" BorderThickness="2" CornerRadius="7" Padding="12,10">
                            <DockPanel>
                                <Border x:Name="Check" DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}" Visibility="Collapsed">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#10202A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#2E3B48" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#2E3B48" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#25444F" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search result in the sidebar -->
        <Style x:Key="SearchResult" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown -->
        <Style x:Key="ChoiceItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="4" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource SelectedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Choice" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Face" Background="{StaticResource ControlBackground}" BorderBrush="#4C5A68" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextStrong}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#425160" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="11,5,28,5"
                                              VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="#22303D"
                                        BorderBrush="#4C5A68"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3D4854" CornerRadius="3" Margin="2,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Backdrop" Background="#80080E14" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Border x:Name="SettingsCard"
                Background="{StaticResource ContentBackground}"
                BorderBrush="{StaticResource ModalBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="24"
                MaxWidth="1280"
                MaxHeight="950"
                MouseLeftButtonDown="Modal_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="10,0,0,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="8,8,8,4" Padding="10,7" CornerRadius="6">
                            <DockPanel>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource TextNormal}" VerticalAlignment="Center" />
                                <Border x:Name="SearchKeyHint" DockPanel.Dock="Right" Background="{StaticResource ControlBackground}" CornerRadius="3" Padding="6,0">
                                    <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextNormal}" />
                                </Border>
                                <Button x:Name="ClearSearch"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource HeaderButton}"
                                        Margin="0,-4,-6,-4"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Clear search"
                                        Click="ClearSearch_Click">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" />
                                </Button>
                                <Grid Margin="10,0,0,0">
                                    <TextBlock x:Name="SearchHint" Text="Search" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextNormal}" IsHitTestVisible="False" />
                                    <TextBox x:Name="SearchBox"
                                             AutomationProperties.Name="Search settings"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="-2,0,0,0"
                                             FontSize="14"
                                             FontWeight="Medium"
                                             Foreground="{StaticResource TextStrong}"
                                             CaretBrush="{StaticResource TextStrong}"
                                             FocusVisualStyle="{x:Null}"
                                             TextChanged="SearchBox_TextChanged"
                                             KeyDown="SearchBox_KeyDown" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,2,8">
                            <Grid Margin="0,0,6,0">
                                <StackPanel x:Name="NavList" />
                                <StackPanel x:Name="SearchResults" Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Page -->
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10,14,10" MinHeight="47">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Margin="6,0,0,0" Click="Close_Click" AutomationProperties.Name="Close settings">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="12" />
                            </Button>
                            <Button x:Name="RestoreDefaults"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource HeaderButton}"
                                    AutomationProperties.Name="Restore defaults"
                                    Click="RestoreDefaults_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="RestoreLabel" Text="Restore defaults" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <TextBlock Text="/" FontSize="14" Margin="9,0" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="PageName" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Margin="0,0,2,4">
                        <StackPanel x:Name="PageContent" MaxWidth="780" Margin="44,12,44,32" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Add provider wizard, on top of settings -->
        <Grid x:Name="WizardLayer"
              Background="#80080E14"
              Visibility="Collapsed"
              MouseLeftButtonDown="WizardLayer_MouseLeftButtonDown">
            <Border x:Name="WizardCard"
                    Background="#1C2732"
                    BorderBrush="{StaticResource ModalBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="Modal_MouseLeftButtonDown" />
        </Grid>
    </Grid>
</UserControl>
