<Window x:Class="AgentOrange.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentOrange"
        Title="Agent Orange" Height="720" Width="1100"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBackground}">
    <Grid>
        <Grid x:Name="MainContent" Margin="40,28,40,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main screen: pick a project -->
            <DockPanel x:Name="ProjectSelectView">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="Agent Orange"
                               Foreground="{StaticResource TextStrong}"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenSettings"
                                Content="Settings"
                                Style="{StaticResource HeaderButton}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Click="OpenSettings_Click" />
                        <Button x:Name="NewProject"
                                Content="New project"
                                Style="{StaticResource PrimaryButton}"
                                Click="NewProject_Click" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <StackPanel x:Name="NoProjects" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No projects yet"
                                   Foreground="{StaticResource TextStrong}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Create one to get started."
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="14"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer x:Name="ProjectScroller" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ProjectGrid"
                                   AllowDrop="True"
                                   Background="Transparent"
                                   DragOver="ProjectGrid_DragOver"
                                   Drop="ProjectGrid_Drop" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- An open project. Its top image runs edge to edge. -->
            <ScrollViewer x:Name="ProjectView"
                          Visibility="Collapsed"
                          Margin="-40,-28,-40,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProjectPage" />
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <TextBlock x:Name="ServerStatus"
                           Text="Connecting to server…"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12" />
                <TextBlock x:Name="VersionLabel"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <local:NewProjectWizard x:Name="ProjectWizard"
                                Visibility="Collapsed"
                                Created="ProjectWizard_Created"
                                Closed="ProjectWizard_Closed" />

        <local:ProjectSettingsModal x:Name="ProjectSettings"
                                    Visibility="Collapsed"
                                    Changed="ProjectSettings_Changed"
                                    Closed="ProjectSettings_Closed"
                                    Deleted="ProjectSettings_Deleted" />

        <local:SettingsModal x:Name="Settings" Visibility="Collapsed" Closed="Settings_Closed" />

        <!-- Updates are mandatory: this covers the whole app and can't be dismissed. -->
        <Grid x:Name="UpdateOverlay" Background="#D917212B" Visibility="Collapsed">
            <Border Background="#1C2732"
                    BorderBrush="{StaticResource ModalBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle"
                               Foreground="{StaticResource TextStrong}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock x:Name="UpdateMessage"
                               Foreground="{StaticResource TextNormal}"
                               FontSize="14"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <ProgressBar x:Name="UpdateProgress"
                                 Height="6"
                                 Margin="0,18,0,0"
                                 Maximum="100"
                                 Foreground="{StaticResource Accent}"
                                 Background="{StaticResource ControlBackground}"
                                 BorderThickness="0"
                                 Visibility="Collapsed" />
                    <Button x:Name="DownloadUpdate"
                            Content="Download update"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Click="DownloadUpdate_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
