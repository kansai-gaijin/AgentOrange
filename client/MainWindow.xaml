<Window x:Class="AgentOrange.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentOrange"
        Title="Agent Orange" Height="720" Width="1100"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#16181D">
    <Window.Resources>
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#16181D" />
            <Setter Property="Background" Value="#FF8A1F" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FFA24D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#E67A12" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C4C9D2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#2A2E36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectCard" TargetType="Button">
            <Setter Property="Width" Value="300" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="#22262E" BorderBrush="#2F343D" BorderThickness="1" CornerRadius="8" Padding="20,18">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF8A1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainContent" Margin="40,32,40,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main screen: pick a project -->
            <DockPanel x:Name="ProjectSelectView">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="Agent Orange"
                               Foreground="#FF8A1F"
                               FontSize="28"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenSettings"
                                Content="Settings"
                                Style="{StaticResource QuietButton}"
                                Margin="0,0,8,0"
                                Click="OpenSettings_Click" />
                        <Button x:Name="NewProject"
                                Content="New project"
                                Style="{StaticResource OrangeButton}"
                                Click="NewProject_Click" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <StackPanel x:Name="NoProjects" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No projects yet"
                                   Foreground="#E6E8EC"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Create one to get started."
                                   Foreground="#9AA0AA"
                                   FontSize="14"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProjectList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProjectCard}"
                                            AutomationProperties.Name="{Binding Name}"
                                            Click="OpenProject_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#E6E8EC"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="#9AA0AA"
                                                       FontSize="13"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- An open project. Empty for now. -->
            <DockPanel x:Name="ProjectView" Visibility="Collapsed">
                <Button x:Name="BackToProjects"
                        Content="← Projects"
                        DockPanel.Dock="Top"
                        Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left"
                        Margin="-14,0,0,16"
                        Click="BackToProjects_Click" />
                <TextBlock x:Name="OpenProjectName"
                           DockPanel.Dock="Top"
                           Foreground="#E6E8EC"
                           FontSize="28"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="OpenProjectDetails"
                           DockPanel.Dock="Top"
                           Foreground="#9AA0AA"
                           FontSize="14"
                           Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="OpenProjectRepo"
                           DockPanel.Dock="Top"
                           Foreground="#9AA0AA"
                           FontSize="14"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Nothing here yet."
                           Foreground="#9AA0AA"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <TextBlock x:Name="ServerStatus"
                           Text="Connecting to server…"
                           Foreground="#9AA0AA"
                           FontSize="12" />
                <TextBlock x:Name="VersionLabel"
                           Foreground="#6B7280"
                           FontSize="12"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <local:NewProjectWizard x:Name="ProjectWizard"
                                Visibility="Collapsed"
                                Created="ProjectWizard_Created"
                                Closed="ProjectWizard_Closed" />

        <local:SettingsModal x:Name="Settings" Visibility="Collapsed" Closed="Settings_Closed" />

        <!-- Updates are mandatory: this covers the whole app and can't be dismissed. -->
        <Grid x:Name="UpdateOverlay" Background="#D916181D" Visibility="Collapsed">
            <Border Background="#22262E"
                    CornerRadius="8"
                    Padding="28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle"
                               Foreground="#FF8A1F"
                               FontSize="24"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock x:Name="UpdateMessage"
                               Foreground="#C4C9D2"
                               FontSize="14"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <ProgressBar x:Name="UpdateProgress"
                                 Height="6"
                                 Margin="0,18,0,0"
                                 Maximum="100"
                                 Foreground="#FF8A1F"
                                 Background="#2A2E36"
                                 BorderThickness="0"
                                 Visibility="Collapsed" />
                    <Button x:Name="DownloadUpdate"
                            Content="Download update"
                            Style="{StaticResource OrangeButton}"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Click="DownloadUpdate_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
