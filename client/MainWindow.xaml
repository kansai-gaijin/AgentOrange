<Window x:Class="AgentOrange.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Orange" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#16181D">
    <Grid>
        <Grid x:Name="MainContent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Agent Orange"
                           Foreground="#FF8A1F"
                           FontSize="48"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ServerStatus"
                           Text="Connecting to server…"
                           Foreground="#9AA0AA"
                           FontSize="16"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="VersionLabel"
                       Foreground="#6B7280"
                       FontSize="12"
                       Margin="12"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" />
        </Grid>

        <!-- Updates are mandatory: this covers the whole app and can't be dismissed. -->
        <Grid x:Name="UpdateOverlay" Background="#D916181D" Visibility="Collapsed">
            <Border Background="#22262E"
                    CornerRadius="8"
                    Padding="28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle"
                               Foreground="#FF8A1F"
                               FontSize="24"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock x:Name="UpdateMessage"
                               Foreground="#C4C9D2"
                               FontSize="14"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <ProgressBar x:Name="UpdateProgress"
                                 Height="6"
                                 Margin="0,18,0,0"
                                 Maximum="100"
                                 Foreground="#FF8A1F"
                                 Background="#2A2E36"
                                 BorderThickness="0"
                                 Visibility="Collapsed" />
                    <Button x:Name="DownloadUpdate"
                            Content="Download update"
                            Padding="20,8"
                            Margin="0,18,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#16181D"
                            Background="#FF8A1F"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            Click="DownloadUpdate_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
