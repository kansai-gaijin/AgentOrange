<UserControl x:Class="AgentOrange.NewProjectWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             KeyDown="Wizard_KeyDown">
    <Grid Background="#80080E14" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Border x:Name="Card"
                Background="#1C2732"
                BorderBrush="{StaticResource ModalBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Width="620"
                Margin="0,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MouseLeftButtonDown="Card_MouseLeftButtonDown" />
    </Grid>
</UserControl>
